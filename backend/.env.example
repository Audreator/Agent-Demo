# Backend
APP_ENV=dev
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55432/agent
AUTO_MIGRATE=true
DOCS_ROOT=./docs
DEV_USER_ID=dev-user

CONTEXT_WINDOW=1000000
CONTEXT_BUDGET_RATIO=0.7
# CONTEXT_COMPRESS_THRESHOLD=2000
KEEP_RECENT_TURNS=5
MAX_TASK_TURNS=30
MAX_TOOL_ITERATIONS=8
MAX_MODEL_CALLS_PER_TURN=12
MAX_SELF_CORRECT=5
TOOL_RETRY=3
LLM_RETRY=3
LLM_RETRY_BASE_DELAY=0.5
BREAKER_OPEN_SECONDS=30

MODEL_LAYERS=deepseek,qwen,local
MODEL_L1_BASE_URL=https://api.deepseek.com
MODEL_L1_API_KEY=
MODEL_L1_NAME=deepseek-flash
MODEL_L2_BASE_URL=
MODEL_L2_API_KEY=
MODEL_L2_NAME=qwen-plus
MODEL_L3_BASE_URL=
MODEL_L3_API_KEY=
MODEL_L3_NAME=local-model

DEEPSEEK_SEARCH_ENABLED=true
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_MODEL=deepseek-v4-pro

# T26102201 citations / admin
ADMIN_MAX_RANGE_DAYS=90
ADMIN_PAGE_SIZE=50
ADMIN_EXPORT_MAX_ROWS=10000
CITATION_DISPLAY_LIMIT=3
CITATION_MAX_TOTAL=10
LINK_CHECK_TIMEOUT=8.0
LINK_CHECK_CONCURRENCY=5
LINK_CHECK_CACHE_TTL=600
EVENTS_RETENTION_DAYS=90
FEEDBACK_REASON_MAX=200
ADMIN_ALERT_TOOL_FAILURE_RATE=0.2
ADMIN_ALERT_MIN_TOOL_CALLS=10
ADMIN_ALERT_SATISFACTION_RATE=0.7
ADMIN_ALERT_MIN_FEEDBACKS=5
ADMIN_ALERT_P95_MS=60000
ADMIN_ALERT_MIN_TURNS=10
ADMIN_ALERT_BREAKER_COUNT=1
ADMIN_ALERT_WRAP_COUNT=3
